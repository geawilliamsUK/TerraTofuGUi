    "app-web": {
      "id": "app-web",
      "name": "web",
      "resource_type": "container_app",
      "config": {
        "size": "medium",
        "cpu_architecture": "arm64",
        "port": 8080,
        "replicas": 2,
        "public": false,
        "repository": "shop-web",
        "image_tag": "1.4.2",
        "env": [
          {
            "name": "WORKER_MODE",
            "value": "external"
          },
          {
            "name": "PORT",
            "value": "8080"
          }
        ],
        "secrets": [
          {
            "name": "DATABASE_URL",
            "key": "DATABASE_URL"
          },
          {
            "name": "SESSION_SECRET",
            "key": "SESSION_SECRET"
          },
          {
            "name": "PAYMENTS_KEY",
            "secret": "sec-app",
            "key": "PAYMENTS_KEY"
          }
        ],
        "health_check_path": "/api/health",
        "health_check_interval": 30,
        "health_check_timeout": 5,
        "health_check_retries": 3,
        "health_check_start_period": 30,
        "stop_timeout": 30,
        "delete_objects": true,
        "db_user": "web"
      },
      "provider_config": {},
      "position": {
        "x": 560,
        "y": 480
      },
      "parent": "env-apps",
      "manual": false
    },
    "app-worker": {
      "id": "app-worker",
      "name": "worker",
      "resource_type": "container_app",
      "config": {
        "size": "medium",
        "cpu_architecture": "arm64",
        "port": 8081,
        "replicas": 1,
        "background_worker": true,
        "repository": "shop-worker",
        "env": [
          {
            "name": "WORKER_HEALTH_PORT",
            "value": "8081"
          },
          {
            "name": "WORKER_JOB_CONCURRENCY",
            "value": "2"
          }
        ],
        "secrets": [
          {
            "name": "DATABASE_URL",
            "key": "DATABASE_URL"
          }
        ],
        "health_check_path": "/healthz",
        "health_check_command": "node -e \"fetch('http://127.0.0.1:8081/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"",
        "health_check_interval": 30,
        "health_check_timeout": 5,
        "health_check_retries": 3,
        "health_check_start_period": 30,
        "stop_timeout": 120
      },
      "provider_config": {},
      "position": {
        "x": 800,
        "y": 480
      },
      "parent": "env-apps",
      "manual": false
