    "sg-lb": {
      "id": "sg-lb",
      "name": "lb sg",
      "resource_type": "security_group",
      "config": {
        "rules": [
          {
            "name": "https-in",
            "direction": "ingress",
            "protocol": "tcp",
            "from_port": 443,
            "to_port": 443,
            "cidr": "0.0.0.0/0",
            "source_group": "",
            "description": "HTTPS from anywhere"
          },
          {
            "name": "to-apps",
            "direction": "egress",
            "protocol": "tcp",
            "from_port": 8080,
            "to_port": 8080,
            "cidr": "10.40.0.0/16",
            "source_group": "",
