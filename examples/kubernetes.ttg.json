      "name": "platform",
      "resource_type": "kubernetes_cluster",
      "config": {
        "node_size": "medium",
        "node_count": 2,
        "min_nodes": 2,
        "max_nodes": 4,
        "private_endpoint": false,
        "addons": [
          "pod_identity_agent",
          "ebs_csi",
          "metrics_server"
        ]
      },
      "provider_config": {},
      "position": {
        "x": 700,
        "y": 380
      },
      "parent": "vnet-core",
