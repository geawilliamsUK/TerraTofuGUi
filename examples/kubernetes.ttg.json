    "pool-gpu": {
      "id": "pool-gpu",
      "name": "gpu",
      "resource_type": "kubernetes_node_pool",
      "config": {
        "size": "large",
        "min_nodes": 0,
        "max_nodes": 4,
        "desired_nodes": 0,
        "spot": true,
        "gpu": true,
        "labels": [
          "workload=asr"
        ],
        "taints": [
          {
            "key": "nvidia.com/gpu",
            "value": "present",
            "effect": "NoSchedule"
          }
        ]
      },
      "provider_config": {
        "aws": {
          "instance_type": "g5.xlarge"
        },
        "azure": {
          "pool_name": "gpu",
          "instance_type": "Standard_NC6s_v3"
        },
        "gcp": {
          "instance_type": "n1-standard-4",
          "accelerator_type": "nvidia-tesla-t4",
          "accelerator_count": 1
        }
      },
      "position": {
        "x": 700,
        "y": 560
      },
      "parent": "vnet-core",
      "manual": false
    },
