{
  "name": "Queue-driven GPU worker",
  "description": "A Kubernetes workload on a GPU node pool of `cluster` that scales from zero on the depth of a queue (a new one, or `queue`), running as its own role and logging to its own log group. The pool is spot, tainted for GPU work and scales to zero when idle.",
  "params": [
    {
      "name": "name",
      "description": "Display name of the workload; the pool, role, logs and queue are named after it",
      "default": "gpu worker"
    },
    {
      "name": "cluster",
      "description": "The Kubernetes Cluster the pool and the workload run in",
      "entity": "kubernetes_cluster"
    },
    {
      "name": "queue",
      "description": "An existing Event Queue to scale on instead of creating one",
      "entity": "event_queue",
      "optional": true
    },
    {
      "name": "namespace",
      "description": "Kubernetes namespace of the workload",
      "default": "workers"
    },
    {
      "name": "repository",
      "description": "Image repository in the linked registry",
      "default": "{name|kebab}"
    },
    {
      "name": "image_tag",
      "description": "Image tag to run",
      "default": "1.0.0"
    },
    {
      "name": "namespace_name",
      "description": "Globally unique Azure Service Bus namespace for a new queue",
      "default": "{project|kebab}-{name|kebab}-bus"
    }
  ],
  "entities": [
    {
      "key": "pool",
      "type": "kubernetes_node_pool",
      "name": "{name} pool",
      "parent": "@cluster",
      "at": [0, 0],
      "config": {
        "size": "large",
        "min_nodes": 0,
        "max_nodes": 4,
        "desired_nodes": 0,
        "spot": true,
        "gpu": true,
        "labels": ["workload={name|kebab}"],
        "taints": [{ "key": "nvidia.com/gpu", "value": "present", "effect": "NoSchedule" }],
        "disk_size_gb": 200
      },
      "provider_config": {
        "aws": { "instance_type": "g5.xlarge" },
        "azure": { "pool_name": "{name|alnum|max:12}", "instance_type": "Standard_NC6s_v3" },
        "gcp": { "instance_type": "n1-standard-4", "accelerator_type": "nvidia-tesla-t4", "accelerator_count": 1 }
      }
    },
    {
      "key": "workload",
      "type": "kubernetes_workload",
      "name": "{name}",
      "at": [240, 0],
      "config": {
        "namespace": "{namespace|kebab}",
        "service_account": "{name|kebab}",
        "repository": "{repository}",
        "image_tag": "{image_tag}",
        "cpu": "2",
        "memory": "8Gi",
        "gpu": 1,
        "min_replicas": 0,
        "max_replicas": 4,
        "messages_per_replica": 2
      }
    },
    {
      "key": "role",
      "type": "iam_role",
      "name": "{name} role",
      "at": [480, 0],
      "config": { "trusted_service": "kubernetes", "permissions": "none" }
    },
    {
      "key": "logs",
      "type": "log_group",
      "name": "{name} logs",
      "at": [480, 100],
      "config": { "retention_days": 30 }
    },
    {
      "key": "jobs",
      "type": "event_queue",
      "name": "{name} jobs",
      "at": [240, 100],
      "when": "!queue",
      "config": { "visibility_timeout_seconds": 300 },
      "provider_config": { "azure": { "namespace_name": "{namespace_name|kebab|max:50}" } }
    }
  ],
  "links": [
    { "source": "pool", "target": "$cluster", "relation": "attachment" },
    { "source": "workload", "target": "$cluster", "relation": "attachment" },
    { "source": "workload", "target": "pool", "relation": "attachment" },
    { "source": "workload", "target": "role", "relation": "iam_binding" },
    { "source": "workload", "target": "logs", "relation": "logs_to" },
    { "source": "workload", "target": "jobs", "relation": "attribute_reference", "when": "!queue" },
    { "source": "workload", "target": "$queue", "relation": "attribute_reference", "when": "queue" }
  ]
}
